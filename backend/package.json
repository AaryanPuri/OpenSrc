{
  "name": "opensrc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/node.js",
    "start:prod": "NODE_ENV=production node dist/backend/src/node.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "collect": "tsx src/pipeline/cli.ts collect",
    "validate-data": "tsx src/pipeline/cli.ts validate"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
