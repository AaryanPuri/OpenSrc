# Optional: enables LLM query parsing (Claude Haiku 4.5). Without it, the rules parser is used.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional but strongly recommended: raises GitHub search rate limit (10 -> 30 req/min) and enables star enrichment.
GITHUB_TOKEN=
# Port for the local Node server
PORT=8787
