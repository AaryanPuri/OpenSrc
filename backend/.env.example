# Optional: enables LLM query parsing (Claude Haiku 4.5). Without it, the rules parser is used.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional but strongly recommended: raises GitHub search rate limit (10 -> 30 req/min) and enables star enrichment.
GITHUB_TOKEN=
# Port for the local Node server
PORT=8787
# Repo-directory collector (npm run collect) uses COLLECTOR_TOKEN, else GITHUB_TOKEN.
# Any token that can read public repos works. A full run spends roughly 500-1,000 of the 5,000 GraphQL points per hour.
# In GitHub Actions, add it as the COLLECTOR_TOKEN repository secret (the nightly workflow falls back to github.token).
# COLLECTOR_TOKEN=

# --- Build time: read by frontend/scripts/prerender.ts during `npm run build` (set them in the shell or CI;
# the server doesn't load this file for them). See docs/seo-and-prerender.md.
# Public origin for canonical links, Open Graph URLs, sitemap.xml, robots.txt and feed.xml. No trailing slash.
# SITE_URL=https://opensrc.studio
# Only pre-render the N best-scored repo pages, for quick local builds. Leave unset in production:
# repo pages that weren't pre-rendered are answered with 404.html.
# PRERENDER_LIMIT=50
# CI_REQUIRE_SITE_URL=1 fails the build when SITE_URL is missing (CI sets it).
