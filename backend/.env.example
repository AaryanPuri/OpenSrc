# Optional: enables LLM query parsing (Claude Haiku 4.5). Without it, the rules parser is used.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional but strongly recommended: raises GitHub search rate limit (10 -> 30 req/min) and enables star enrichment.
GITHUB_TOKEN=
# Port for the local Node server
PORT=8787
# Repo-directory collector (npm run collect) uses COLLECTOR_TOKEN, else GITHUB_TOKEN.
# Any token that can read public repos works. A full run spends roughly 500-1,000 of the 5,000 GraphQL points per hour.
# In GitHub Actions, add it as the COLLECTOR_TOKEN repository secret (the nightly workflow falls back to github.token).
# COLLECTOR_TOKEN=

# --- Optional: login, synced saves and the weekly newsletter. Each switches itself off when unset,
# and /api/health reports { db, auth, newsletter }. Full setup: docs/deploy.md ("Login & newsletter").
# Public origin: OAuth callback (<SITE_URL>/api/auth/github/callback), email links, allowed Origin for writes.
# For local development through Vite, use the Vite address:
# SITE_URL=http://localhost:5173
# libSQL database. Node also opens local files; the Worker needs Turso (libsql://...).
# DATABASE_URL=file:.data/opensrc.db
# DATABASE_AUTH_TOKEN=
# Login (GitHub OAuth App, no scopes) needs the database, both OAuth values and SESSION_SECRET.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Signs the OAuth state cookie. Any long random string: openssl rand -base64 32
# SESSION_SECRET=
# Newsletter needs the database, NEWSLETTER_SECRET and a mail provider (Resend, or the console locally).
# NEWSLETTER_SECRET=
# RESEND_API_KEY=
# NEWSLETTER_FROM=OpenSrc <digest@opensrc.studio>
# Print emails (with their links) to the server log instead of sending them:
# MAIL_PROVIDER=console
# Most digest emails per UTC day (Resend's free plan: 100 a day):
# DIGEST_DAILY_CAP=90

# --- Build time: read by frontend/scripts/prerender.ts during `npm run build` (set them in the shell or CI;
# the server doesn't load this file for them). See docs/seo-and-prerender.md.
# Public origin for canonical links, Open Graph URLs, sitemap.xml, robots.txt and feed.xml. No trailing slash.
# SITE_URL=https://opensrc.studio
# Only pre-render the N best-scored repo pages, for quick local builds. Leave unset in production:
# repo pages that weren't pre-rendered are answered with 404.html.
# PRERENDER_LIMIT=50
# CI_REQUIRE_SITE_URL=1 fails the build when SITE_URL is missing (CI sets it).
